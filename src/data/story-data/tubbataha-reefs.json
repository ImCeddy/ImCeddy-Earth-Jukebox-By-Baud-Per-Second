  "locationId": "tubbataha-reefs",
  "metric": "monthly_max_degree_heating_weeks",
  "unit": "\u00b0C-weeks",
  "narrationLabel": "the NOAA reef heat-stress index",
  "source": {
    "mission": "NOAA Coral Reef Watch satellite products",
    "product": "Daily Global 5-km Coral Bleaching Heat Stress Monitoring Product Suite, Version 3.1; monthly maximum Degree Heating Week composite",
    "url": "https://www.ncei.noaa.gov/access/metadata/landing-page/bin/iso?id=gov.noaa.nodc:CRW-5km-HeatStressProducts"
  },
  "references": [
    {
      "mission": "NOAA Coral Reef Watch",
      "product": "Degree Heating Week product description and risk thresholds",
      "url": "https://coralreefwatch.noaa.gov/product/5km/index_5km_dhw.php"
    },
    {
      "mission": "UNESCO World Heritage Centre",
      "product": "Tubbataha Reefs Natural Park \u2014 biodiversity and conservation context",
      "url": "https://whc.unesco.org/en/list/653/"
    }
  ],
  "scaleNote": "The NOAA Coral Reef Watch 5-km (0.05-degree) Degree Heating Week product is a satellite-derived measure of accumulated coral-bleaching heat stress, not a direct observation of bleaching, coral cover, biodiversity, or species abundance. This monthly value is the maximum daily DHW in that calendar month at one valid-water grid cell centered at 8.825\u00b0N, 119.875\u00b0E, nearest the Tubbataha sample coordinates; it is not an average for the park. DHW accumulates heat stress over the preceding 12 weeks. NOAA's 4 \u00b0C-weeks threshold indicates bleaching risk and 8 \u00b0C-weeks indicates likely reef-wide bleaching with mortality among heat-sensitive corals; these are risk thresholds, not observed outcomes. Missing archive months remain gaps and are not interpolated. The currently archived monthly composites end in 2024-09; months beyond that date are unavailable in this archive snapshot.",
  "availabilityNote": "The currently archived monthly composites end in 2024-09; months beyond that date are unavailable in this archive snapshot.",
  "sampling": {
    "method": "For each archived calendar-month composite, sampled the nearest 0.05-degree grid cell to 8.82\u00b0N, 119.87\u00b0E. The selected cell center is 8.825\u00b0N, 119.875\u00b0E; NOAA's pixel mask was required to identify valid water. The product's 0.01 scale factor was applied. Monthly composites report each cell's maximum daily DHW in that month.",
    "gridCellCenter": {
      "latitude": 8.825,
      "longitude": 119.875
    },
    "missingMonths": [
      "2023-11",
      "2023-12",
      "2024-01",
      "2024-02"
    ],
    "archiveEnd": "2024-09",
    "archivePartial": true
  },
